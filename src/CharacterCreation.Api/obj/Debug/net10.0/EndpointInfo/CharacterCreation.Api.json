              "integer",
              "string"
            ],
            "format": "int32"
          },
          "wisdom": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "charisma": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CharacterSheetDto": {
        "required": [
          "characterId",
          "name",
          "race",
          "class",
          "level",
          "baseScores",
          "appliedModifiers",
          "finalScores",
          "abilityModifiers",
          "proficiencyBonus"
        ],
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "race": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "level": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
